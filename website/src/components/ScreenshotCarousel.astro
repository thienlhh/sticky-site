---
// ScreenshotCarousel.astro - Interactive Product Tour Carousel
const slides = [
  {
    id: "saved-views",
    step: "01",
    shortTitle: "1. Saved Views",
    fullTitle: "Saved Views & One-Click Restore",
    url: "app.analytics-portal.io/reports/sprint-board",
    src: "/screenshots/screenshot-1-saved-views.png",
    alt: "StickySite popup interface showing saved views list with one-click restore buttons",
    badgeText: "Instant 14ms Restore",
    badgeType: "emerald",
    caption: "Open the popup on any webpage to instantly view and restore your saved filter configurations in a single click."
  },
  {
    id: "capture-review",
    step: "02",
    shortTitle: "2. Capture Review",
    fullTitle: "Selective Control Review",
    url: "app.analytics-portal.io/reports/sprint-board?filter=review",
    src: "/screenshots/screenshot-2-capture-review.png",
    alt: "StickySite capture review screen showing discovered form controls and switches",
    badgeText: "Granular Privacy",
    badgeType: "indigo",
    caption: "Inspect every detected dropdown, checkbox, and search input. Toggle off any sensitive fields or unwanted query parameters."
  },
  {
    id: "name-view",
    step: "03",
    shortTitle: "3. Name & Organize",
    fullTitle: "Custom Preset Naming & Scope",
    url: "app.analytics-portal.io/reports/sprint-board#save-preset",
    src: "/screenshots/screenshot-3-name-view.png",
    alt: "StickySite name view modal with view name input and origin/path scope options",
    badgeText: "Flexible Scope",
    badgeType: "purple",
    caption: "Assign clear names and custom scope rules (origin-wide or specific URL path) so views appear exactly where you need them."
  },
  {
    id: "restoration-status",
    step: "04",
    shortTitle: "4. Live Verification",
    fullTitle: "Live Restoration Diagnostics",
    url: "app.analytics-portal.io/reports/sprint-board?status=restored",
    src: "/screenshots/screenshot-4-restoration-status.png",
    alt: "StickySite restoration status showing 100% matched controls and timing diagnostics",
    badgeText: "Zero-Error Verification",
    badgeType: "emerald",
    caption: "Get immediate, transparent confirmation of every field matched, restored, and event dispatched with execution time."
  }
];
---

<div class="carousel-container" id="screenshots" role="region" aria-roledescription="carousel" aria-label="StickySite Extension Screenshots">
  <!-- Interactive Step Tabs -->
  <div class="carousel-tabs" role="tablist" aria-label="Screenshot Steps">
    {slides.map((slide, idx) => (
      <button 
        type="button" 
        class={`carousel-tab ${idx === 0 ? 'active' : ''}`}
        role="tab"
        aria-selected={idx === 0 ? "true" : "false"}
        aria-controls={`slide-${slide.id}`}
        data-index={idx}
      >
        <span class="tab-step">{slide.step}</span>
        <span class="tab-title">{slide.shortTitle}</span>
      </button>
    ))}
  </div>

  <!-- Browser Frame Window -->
  <div class="browser-window glass-card">
    <!-- Window Bar Header -->
    <div class="window-bar">
      <div class="window-dots">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
      </div>

      <div class="window-url-bar">
        <svg class="url-lock-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span class="url-protocol">https://</span>
        <span class="url-text" id="carousel-url-text">{slides[0].url}</span>
      </div>

      <div class="window-badge">
        <span class="pulse-indicator"></span>
        <span class="badge-text" id="carousel-step-indicator">Step 1 of 4</span>
      </div>
    </div>

    <!-- Slides Stage -->
    <div class="slides-stage">
      <!-- Arrow Nav: Previous -->
      <button type="button" class="nav-arrow nav-arrow-prev" id="carousel-prev-btn" aria-label="Previous screenshot">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Slides -->
      <div class="slides-track">
        {slides.map((slide, idx) => (
          <div 
            id={`slide-${slide.id}`}
            class={`carousel-slide ${idx === 0 ? 'active' : ''}`}
            role="tabpanel"
            aria-label={`${slide.step} of 4: ${slide.fullTitle}`}
            data-index={idx}
            data-url={slide.url}
            data-step={idx + 1}
          >
            <img 
              src={slide.src} 
              alt={slide.alt}
              class="slide-img"
              width="1280"
              height="800"
              loading={idx === 0 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={idx === 0 ? "high" : undefined}
            />
          </div>
        ))}
      </div>

      <!-- Arrow Nav: Next -->
      <button type="button" class="nav-arrow nav-arrow-next" id="carousel-next-btn" aria-label="Next screenshot">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- Bottom Caption & Progress Bar -->
    <div class="carousel-footer">
      <div class="carousel-caption-wrap">
        <div class="caption-header">
          <span class="caption-pill" id="carousel-badge">{slides[0].badgeText}</span>
          <h4 class="caption-title" id="carousel-title">{slides[0].fullTitle}</h4>
        </div>
        <p class="caption-desc" id="carousel-desc">{slides[0].caption}</p>
      </div>

      <div class="carousel-controls">
        <!-- Pagination Dots -->
        <div class="carousel-dots" role="tablist" aria-label="Slide indicators">
          {slides.map((slide, idx) => (
            <button 
              type="button" 
              class={`dot-btn ${idx === 0 ? 'active' : ''}`}
              aria-label={`Go to slide ${idx + 1}: ${slide.shortTitle}`}
              data-index={idx}
            >
              <span class="dot-inner"></span>
            </button>
          ))}
        </div>

        <!-- Autoplay Status Indicator -->
        <button type="button" class="autoplay-btn" id="carousel-play-btn" aria-label="Pause autoplay">
          <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
          <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display: none;">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Client-Side Vanilla JS Carousel Controller
  const initCarousel = () => {
    const container = document.querySelector<HTMLElement>('.carousel-container');
    if (!container) return;

    const tabs = container.querySelectorAll<HTMLButtonElement>('.carousel-tab');
    const slides = container.querySelectorAll<HTMLElement>('.carousel-slide');
    const dots = container.querySelectorAll<HTMLButtonElement>('.dot-btn');
    const prevBtn = container.querySelector<HTMLButtonElement>('#carousel-prev-btn');
    const nextBtn = container.querySelector<HTMLButtonElement>('#carousel-next-btn');
    const playBtn = container.querySelector<HTMLButtonElement>('#carousel-play-btn');
    const urlText = container.querySelector<HTMLElement>('#carousel-url-text');
    const stepIndicator = container.querySelector<HTMLElement>('#carousel-step-indicator');
    const badgeEl = container.querySelector<HTMLElement>('#carousel-badge');
    const titleEl = container.querySelector<HTMLElement>('#carousel-title');
    const descEl = container.querySelector<HTMLElement>('#carousel-desc');

    const slideData = [
      {
        url: "app.analytics-portal.io/reports/sprint-board",
        badge: "Instant 14ms Restore",
        title: "Saved Views & One-Click Restore",
        desc: "Open the popup on any webpage to instantly view and restore your saved filter configurations in a single click."
      },
      {
        url: "app.analytics-portal.io/reports/sprint-board?filter=review",
        badge: "Granular Privacy",
        title: "Selective Control Review",
        desc: "Inspect every detected dropdown, checkbox, and search input. Toggle off any sensitive fields or unwanted query parameters."
      },
      {
        url: "app.analytics-portal.io/reports/sprint-board#save-preset",
        badge: "Flexible Scope",
        title: "Custom Preset Naming & Scope",
        desc: "Assign clear names and custom scope rules (origin-wide or specific URL path) so views appear exactly where you need them."
      },
      {
        url: "app.analytics-portal.io/reports/sprint-board?status=restored",
        badge: "Zero-Error Verification",
        title: "Live Restoration Diagnostics",
        desc: "Get immediate, transparent confirmation of every field matched, restored, and event dispatched with execution time."
      }
    ];

    let currentIndex = 0;
    let isPlaying = true;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;

    const updateUI = (index: number) => {
      currentIndex = index;

      // Update slides
      slides.forEach((slide, idx) => {
        if (idx === index) {
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
        }
      });

      // Update tabs
      tabs.forEach((tab, idx) => {
        if (idx === index) {
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
        } else {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
        }
      });

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });

      // Update Header URL & Step
      const data = slideData[index];
      if (urlText) urlText.textContent = data.url;
      if (stepIndicator) stepIndicator.textContent = `Step ${index + 1} of ${slides.length}`;
      if (badgeEl) badgeEl.textContent = data.badge;
      if (titleEl) titleEl.textContent = data.title;
      if (descEl) descEl.textContent = data.desc;
    };

    const next = () => {
      const nextIndex = (currentIndex + 1) % slides.length;
      updateUI(nextIndex);
    };

    const prev = () => {
      const prevIndex = (currentIndex - 1 + slides.length) % slides.length;
      updateUI(prevIndex);
    };

    const startAutoplay = () => {
      if (autoplayTimer) clearInterval(autoplayTimer);
      autoplayTimer = setInterval(next, 5000);
      isPlaying = true;
      if (playBtn) {
        const pauseIcon = playBtn.querySelector<HTMLElement>('.icon-pause');
        const playIcon = playBtn.querySelector<HTMLElement>('.icon-play');
        if (pauseIcon) pauseIcon.style.display = 'block';
        if (playIcon) playIcon.style.display = 'none';
        playBtn.setAttribute('aria-label', 'Pause autoplay');
      }
    };

    const stopAutoplay = () => {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
      isPlaying = false;
      if (playBtn) {
        const pauseIcon = playBtn.querySelector<HTMLElement>('.icon-pause');
        const playIcon = playBtn.querySelector<HTMLElement>('.icon-play');
        if (pauseIcon) pauseIcon.style.display = 'none';
        if (playIcon) playIcon.style.display = 'block';
        playBtn.setAttribute('aria-label', 'Start autoplay');
      }
    };

    // Events
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = parseInt(tab.getAttribute('data-index') || '0', 10);
        updateUI(idx);
        stopAutoplay();
      });
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        updateUI(idx);
        stopAutoplay();
      });
    });

    nextBtn?.addEventListener('click', () => {
      next();
      stopAutoplay();
    });

    prevBtn?.addEventListener('click', () => {
      prev();
      stopAutoplay();
    });

    playBtn?.addEventListener('click', () => {
      if (isPlaying) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    });

    // Pause on hover
    container.addEventListener('mouseenter', () => {
      if (isPlaying && autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    });

    container.addEventListener('mouseleave', () => {
      if (isPlaying && !autoplayTimer) {
        autoplayTimer = setInterval(next, 5000);
      }
    });

    // Keyboard navigation
    container.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') {
        next();
        stopAutoplay();
      } else if (e.key === 'ArrowLeft') {
        prev();
        stopAutoplay();
      }
    });

    // Touch Swipe Support
    let touchStartX = 0;
    let touchEndX = 0;

    container.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    container.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 50) {
        next();
        stopAutoplay();
      } else if (touchEndX - touchStartX > 50) {
        prev();
        stopAutoplay();
      }
    }, { passive: true });

    // Initial start
    startAutoplay();
  };

  // Run on load and ViewTransitions if present
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
</script>

<style>
  .carousel-container {
    width: 100%;
    margin-top: 3.5rem;
    position: relative;
  }

  /* Step Tabs */
  .carousel-tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .carousel-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-full);
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .carousel-tab:hover {
    color: var(--accent-indigo);
    border-color: rgba(79, 70, 229, 0.3);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .carousel-tab.active {
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(124, 58, 237, 0.08) 100%);
    border-color: rgba(79, 70, 229, 0.4);
    color: var(--accent-indigo);
    box-shadow: 0 2px 8px rgba(79, 70, 229, 0.12);
  }

  .tab-step {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: rgba(15, 23, 42, 0.05);
    color: var(--text-muted);
  }

  .carousel-tab.active .tab-step {
    background: var(--accent-indigo);
    color: #ffffff;
  }

  /* Browser Window Shell */
  .browser-window {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg), var(--shadow-glow);
    background: #ffffff;
    overflow: hidden;
    transition: box-shadow 0.3s;
  }

  .browser-window:hover {
    box-shadow: 0 20px 35px -5px rgba(15, 23, 42, 0.12), 0 0 45px -5px rgba(79, 70, 229, 0.25);
  }

  /* Window Top Bar */
  .window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: #f8fafc;
    border-bottom: 1px solid var(--border-subtle);
    gap: 1rem;
  }

  .window-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dot-red { background: #ef4444; }
  .dot-yellow { background: #eab308; }
  .dot-green { background: #22c55e; }

  .window-url-bar {
    flex: 1;
    max-width: 480px;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.78rem;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.03);
    overflow: hidden;
    white-space: nowrap;
  }

  .url-lock-icon {
    color: var(--accent-emerald);
    flex-shrink: 0;
  }

  .url-protocol {
    color: var(--text-muted);
  }

  .url-text {
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
  }

  .window-badge {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-indigo);
    background: rgba(79, 70, 229, 0.08);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .pulse-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-indigo);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  /* Slides Stage */
  .slides-stage {
    position: relative;
    background: #0f172a;
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
  }

  .slides-track {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .carousel-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease-in-out, transform 0.4s ease-out;
    transform: scale(0.985);
  }

  .carousel-slide.active {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Arrow Navigation Buttons */
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(15, 23, 42, 0.1);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.85;
  }

  .slides-stage:hover .nav-arrow {
    opacity: 1;
  }

  .nav-arrow:hover {
    background: #ffffff;
    color: var(--accent-indigo);
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }

  .nav-arrow-prev {
    left: 1.25rem;
  }

  .nav-arrow-next {
    right: 1.25rem;
  }

  /* Carousel Bottom Footer / Caption */
  .carousel-footer {
    padding: 1.25rem 1.75rem;
    background: #ffffff;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .carousel-caption-wrap {
    flex: 1;
  }

  .caption-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.25rem;
  }

  .caption-pill {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    background: rgba(79, 70, 229, 0.1);
    color: var(--accent-indigo);
    border: 1px solid rgba(79, 70, 229, 0.2);
  }

  .caption-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .caption-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Controls: Dots and Autoplay Button */
  .carousel-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .dot-btn {
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dot-inner {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cbd5e1;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dot-btn:hover .dot-inner {
    background: #94a3b8;
    transform: scale(1.2);
  }

  .dot-btn.active .dot-inner {
    width: 24px;
    border-radius: 9999px;
    background: var(--accent-indigo);
  }

  .autoplay-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f1f5f9;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
  }

  .autoplay-btn:hover {
    color: var(--text-primary);
    background: #e2e8f0;
  }

  @media (max-width: 768px) {
    .carousel-container {
      margin-top: 2rem;
    }

    .carousel-tabs {
      overflow-x: auto;
      justify-content: flex-start;
      padding-bottom: 0.5rem;
      flex-wrap: nowrap;
      -webkit-overflow-scrolling: touch;
    }

    .carousel-tab {
      flex-shrink: 0;
      padding: 0.45rem 0.85rem;
      font-size: 0.8rem;
    }

    .window-bar {
      padding: 0.65rem 0.85rem;
    }

    .window-url-bar {
      max-width: 200px;
    }

    .carousel-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem;
    }

    .carousel-controls {
      width: 100%;
      justify-content: space-between;
