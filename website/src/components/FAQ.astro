---
// FAQ.astro
const faqs = [
  {
    q: "How is StickySite different from standard browser bookmarks?",
    a: "Standard browser bookmarks only remember the static webpage URL. Modern single-page applications (like Jira, Mixpanel, Linear, or e-commerce stores) often store active filter states, date ranges, and form choices purely in client-side memory or dynamic DOM controls without updating the address bar. StickySite inspects and restores the actual interactive form elements, dropdown menus, search inputs, and checkboxes on the page."
  },
  {
    q: "What types of form controls and filters can StickySite save?",
    a: "StickySite detects and restores standard and dynamic form controls, including text inputs, search boxes, dropdown selects (<select> and ARIA role='combobox'), date range pickers, number inputs, radio buttons, and checkboxes, along with URL query parameters."
  },
  {
    q: "Can I save multiple views for the same domain?",
    a: "Yes! You can save as many named views per website as you need. For example, on an issue board, you might have 'Q3 High Priority Bugs', 'Sprint 42 Reviews', and 'Unassigned Tasks'. Each view is independently named, updated, or removed with a single click."
  },
  {
    q: "Does StickySite capture passwords, credit cards, or personal data?",
    a: "No. StickySite includes strict safety exclusion filters. Input fields matching password types, credit cards, bank account details, Social Security Numbers, one-time authentication tokens (2FA/OTP), and sensitive query tokens (e.g. auth, jwt, secret) are automatically detected and completely ignored."
  },
  {
    q: "What permissions does StickySite request?",
    a: "StickySite adheres to least-privilege security. It uses 'storage' to persist views locally in your browser, 'scripting' & 'activeTab' to scan form controls when you click the popup, 'tabs' to navigate to your saved URLs, and 'favicon' to display site icons. It declares host permissions as optional, requesting access only for the specific websites where you choose to use the extension."
  },
  {
    q: "Does StickySite submit forms automatically?",
    a: "No. StickySite is strictly non-destructive. It only restores values into form controls and filters. It never triggers 'Submit', 'Pay', 'Buy', 'Delete', or confirmation buttons."
  },
  {
    q: "Where is my data stored? Is an account required?",
    a: "All view presets and configuration data stay 100% on your device inside your browser's local storage. No account is required to use StickySite, and no personal data is uploaded to external cloud servers."
  }
];
---

<section id="faq" class="section-padding faq-section">
  <div class="container">
    <div class="section-header">
      <div class="badge">Answers to Common Questions</div>
      <h2 class="section-title">
        Frequently Asked <span class="gradient-text">Questions</span>
      </h2>
      <p class="section-subtitle">
        Everything you need to know about how StickySite saves, manages, and restores your customized page views.
      </p>
    </div>

    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="glass-card faq-item">
          <summary class="faq-question">
            <span>{faq.q}</span>
            <span class="faq-arrow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #ffffff;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--accent-indigo);
    box-shadow: var(--shadow-md);
  }

  .faq-question {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.35rem 1.75rem;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    gap: 1rem;
    color: var(--text-primary);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: transform 0.25s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
    color: var(--accent-indigo);
  }

  .faq-answer {
    padding: 0 1.75rem 1.5rem 1.75rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    border-top: 1px solid #f1f5f9;
    padding-top: 1rem;
  }
</style>
