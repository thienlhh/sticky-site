---
// Navbar.astro
const CHROME_STORE_URL = "https://chromewebstore.google.com/detail/stickysite-save-and-resto/pfmjhojnaboahgnffghlfaafnfokfich";
---

<header class="navbar">
  <div class="container navbar-inner">
    <a href="/" class="brand">
      <div class="brand-icon">
        <img src="/icons/icon-48.png" alt="StickySite Logo" width="32" height="32" />
      </div>
      <span class="brand-name">StickySite</span>
    </a>

    <nav class="nav-links">
      <a href="#features" class="nav-link">Features</a>
      <a href="#problem" class="nav-link">Why StickySite</a>
      <a href="#demo" class="nav-link">Interactive Demo</a>
      <a href="#use-cases" class="nav-link">Use Cases</a>
      <a href="#security" class="nav-link">Security & Privacy</a>
      <a href="#faq" class="nav-link">FAQ</a>
    </nav>

    <div class="nav-actions">
      <a href={CHROME_STORE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-cta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <circle cx="12" cy="12" r="4"></circle>
          <line x1="21.17" y1="8" x2="12" y2="8"></line>
          <line x1="3.95" y1="6.06" x2="8.54" y2="14"></line>
          <line x1="10.88" y1="21.94" x2="15.46" y2="14"></line>
        </svg>
        <span>Add to Chrome</span>
      </a>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: rgba(255, 255, 255, 0.85);
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    transition: background 0.3s ease;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(79, 70, 229, 0.08);
    border: 1px solid rgba(79, 70, 229, 0.2);
  }


  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--accent-indigo);
  }

  .nav-cta {
    font-size: 0.85rem;
    padding: 0.6rem 1.15rem;
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }
</style>
