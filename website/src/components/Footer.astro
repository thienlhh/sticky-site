---
// Footer.astro
const currentYear = new Date().getFullYear();
const CHROME_STORE_URL = "https://chromewebstore.google.com/detail/stickysite-save-and-resto/pfmjhojnaboahgnffghlfaafnfokfich";
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <div class="brand-icon">
            <img
              src="/icons/icon-48.png"
              alt="StickySite Logo"
              width="28"
              height="28"
            />
          </div>
          <span class="brand-name">StickySite</span>
        </a>
        <p class="footer-tagline">
          The local-first browser extension for saving and restoring search
          filters, interactive form presets, and custom page views.
        </p>
        <div class="footer-badge">
          <span class="pulse-dot"></span>
          <span>Verified Safe & 100% Local-First</span>
        </div>
      </div>

      <div class="footer-nav-groups">
        <div class="nav-group">
          <h4 class="nav-heading">Product</h4>
          <ul class="nav-list">
            <li><a href="#features">Features</a></li>
            <li><a href="#problem">Why StickySite</a></li>
            <li><a href="#demo">Live Demo</a></li>
            <li><a href="#use-cases">Use Cases</a></li>
            <li>
              <a
                href={CHROME_STORE_URL}
                target="_blank"
                rel="noopener noreferrer">Chrome Web Store</a>
            </li>
          </ul>
        </div>

        <div class="nav-group">
          <h4 class="nav-heading">Privacy & Trust</h4>
          <ul class="nav-list">
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="#security">Local-First Storage</a></li>
            <li><a href="#security">Safety Filtering</a></li>
            <li><a href="#faq">Permissions Guide</a></li>
          </ul>
        </div>

        <div class="nav-group">
          <h4 class="nav-heading">Support & Contact</h4>
          <ul class="nav-list">
            <li><a href="mailto:kaoxofu@gmail.com">Contact KAO Studio</a></li>
            <li>
              <a href="https://github.com/thienlhh/sticky-site-feedback/issues"
                >Report a Bug</a>
            </li>
            <li>
              <a href="https://github.com/thienlhh/sticky-site-feedback/issues"
                >Feature Requests</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} StickySite. Created by KAO Studio. Built for productivity
        and privacy.
      </p>
      <div class="bottom-links">
        <a href="/privacy">Privacy Policy</a>
        <span>•</span>
        <a href="mailto:kaoxofu@gmail.com">kaoxofu@gmail.com</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    background: #ffffff;
    padding-top: 5rem;
    padding-bottom: 3rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 3fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: rgba(79, 70, 229, 0.08);
    border: 1px solid rgba(79, 70, 229, 0.2);
  }

  .footer-tagline {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 320px;
  }

  .footer-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgba(5, 150, 105, 0.08);
    border: 1px solid rgba(5, 150, 105, 0.25);
    color: #047857;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  .footer-nav-groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .nav-heading {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-list a {
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .nav-list a:hover {
    color: var(--accent-indigo);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .bottom-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bottom-links a {
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .bottom-links a:hover {
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 600px) {
    .footer-nav-groups {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
